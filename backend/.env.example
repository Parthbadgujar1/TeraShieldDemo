# TeraShield Environment Configuration
# Copy this to .env and fill in actual values (never commit .env)

# API Configuration
APP_NAME=TeraShield
APP_VERSION=1.0.0
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=terashield
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Earth Engine (Optional)
GEE_PROJECT=your-gee-project-id
GEE_CREDENTIALS=/path/to/service-account.json

# File Storage
DATA_DIR=./data
OUTPUT_DIR=./data/processed
TEMP_DIR=./data/temp

# Hazard Intelligence
USE_GEE=false
HAZARD_CACHE_MINUTES=60

# Demo Credentials
DEMO_USER=sih
DEMO_PASS=sih2026
